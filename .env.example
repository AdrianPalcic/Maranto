# Google service account JSON (the whole file content), base64-encoded:
#   Mac/Linux: base64 -i service-account.json | tr -d '\n'
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=

# Calendar ID the service account was shared on (client's calendar)
GOOGLE_CALENDAR_ID=antoniovrdoljak95@gmail.com

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL="Maranto <rezervacije@maranto.hr>"

# Where booking notifications / customer replies should actually land
CLIENT_NOTIFY_EMAIL=

# Random secret used to sign cancel links (any long random string)
CANCEL_SECRET=

# Public site URL, no trailing slash (used to build cancel links)
SITE_URL=https://www.maranto.hr
